{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": { "@/*": ["./src/*"], "@contracts/*": ["../../packages/contracts/src/*"] }
  },
  "include": ["src", "scripts", "tests"]
}
