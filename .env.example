# ---- Agent service (apps/agent) ----
API_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=dev-service-token
PORT=4111

# Anthropic, called directly (docs/05-agent-cost-design.md)
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
EFFORT=medium

# Limits and caching
MAX_SECONDS=300
# Search and page-fetch results are reused for this many hours (0 turns it off)
TOOL_CACHE_HOURS=24

# Research tools
TAVILY_API_KEY=
COMPANIES_HOUSE_API_KEY=
SEC_USER_AGENT=Harrowgate Deal Copilot research@harrowgate.example